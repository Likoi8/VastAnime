# Ключ для шифрования cookie-сессий. Генерируется один раз при первом деплое
# и должен оставаться постоянным (иначе все сессии пользователей слетят
# при каждом перезапуске сервиса).
_SECRET_KEY_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "session_secret.key")

def get_session_secret() -> str:
    if os.path.exists(_SECRET_KEY_PATH):
        with open(_SECRET_KEY_PATH, "rb") as f:
            return f.read().decode("utf-8")
    from cryptography.fernet import Fernet
    key = Fernet.generate_key()
    with open(_SECRET_KEY_PATH, "wb") as f:
        f.write(key)
    os.chmod(_SECRET_KEY_PATH, 0o600)
    return key.decode("utf-8")


